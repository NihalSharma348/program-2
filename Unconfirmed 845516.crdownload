import math, time, shutil

w = shutil.get_terminal_size().columns - 1
chars = " ._-~=*#"
t = 0
try:
    while True:
        rows = []
        for y in range(8):
            row = ""
            for x in range(w):
                v = math.sin(x / 6 + t + y * 0.7) + math.sin(x / 11 - t * 1.3 + y)
                row += chars[int((v + 2) / 4 * (len(chars) - 1))]
            rows.append(row)
        print("\033[H\033[J" + "\n".join(rows))
        t += 0.25
        time.sleep(0.06)
except KeyboardInterrupt:
    print("\nCalm seas.")
